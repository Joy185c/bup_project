# GridWise Environment Configuration
# Copy this file to .env and fill in your values

# --- LLM Provider: "groq" (recommended) or "openai" ---
LLM_PROVIDER=groq

# --- Groq API Key (get from console.groq.com) ---
GROQ_API_KEY=your_groq_api_key_here

# --- OpenAI API Key (alternative provider) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- LLM Model ---
# Groq models:  llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# OpenAI models: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
LLM_MODEL=openai/gpt-oss-120b

# --- Set to "true" ONLY for local testing (no API key needed) ---
# MUST be "false" for hackathon submission
MOCK_LLM=false

# --- Logging level ---
LOG_LEVEL=INFO
